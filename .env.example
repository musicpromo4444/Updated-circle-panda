

# Native store verification secrets (SERVER / Supabase Edge Functions only)
# Google Play
GOOGLE_PLAY_PACKAGE_NAME=com.example.circlepanda
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Apple App Store Server API / In-App Purchase
APPLE_IAP_BUNDLE_ID=com.example.circlepanda
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Never put these secrets in VITE_* variables or client-side code.

# Native bridge contract:
# Android/iOS must call window.CirclePandaNativePurchaseComplete(JSON.stringify({
#   reference, success:true, purchaseToken:"..."   // Google Play
# })) or
# window.CirclePandaNativePurchaseComplete(JSON.stringify({
#   reference, success:true, signedTransaction:"..." // Apple StoreKit JWS
# }))
